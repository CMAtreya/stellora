    "start:node": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "@supabase/supabase-js": "^2.48.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "prisma": "^6.19.2"
  }
}