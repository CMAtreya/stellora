{
  "name": "stellora-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "start": "cd fastapi && python -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
