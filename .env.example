# Split env files live beside each app:
# - frontend/.env for public client-side values (anon key only)
# - backend/.env for server-only values (service role, database URL)
# Supabase Postgres connection string (server-only)
DATABASE_URL=

# Supabase project URL (for Edge Functions)
SUPABASE_URL=
# Supabase service role key (never expose to frontend)
SUPABASE_SERVICE_ROLE=
# OpenTripMap API key
OPENTRIPMAP_API_KEY=
# Gemini API key (server-only)
GEMINI_API_KEY=
# Google Places API key (for hours/open-now; server-only)
GOOGLE_PLACES_API_KEY=
# Allowed origin for CORS (e.g., http://localhost:5173 or https://yourdomain.com)
ALLOWED_ORIGIN=*
